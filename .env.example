# Copy to .env and fill in. .env is gitignored: never commit real values.

# Production canonical domain. Read everywhere via process.env.NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL=https://albatros.uz

# Analytics (leave empty locally; the owner sets these in the Hostinger environment).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# REQUIRED for the contact form. Bitrix24 inbound webhook base URL; grants write
# access to the CRM, so set it only in the server environment, never in git.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/your_webhook_token/
