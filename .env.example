# Copy to .env and fill in. The owner sets the analytics IDs in the Hostinger
# environment settings (Hosting, Advanced, Environment variables), NOT in code.

# Production canonical domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://albatros.uz

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Empty = GA disabled.
NEXT_PUBLIC_GA_ID=

# Yandex Metrica counter ID, e.g. 12345678. Empty = Metrica disabled.
NEXT_PUBLIC_YM_ID=
